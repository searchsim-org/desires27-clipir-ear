{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clipir-ear/v1/segments.sync",
  "title": "segments.sync",
  "type": "object",
  "required": [
    "t",
    "session_id",
    "segments"
  ],
  "properties": {
    "t": {
      "const": "segments.sync"
    },
    "id": {
      "type": "string"
    },
    "session_id": {
      "type": "string"
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "t0",
          "t1",
          "text"
        ],
        "properties": {
          "t0": {
            "type": "number"
          },
          "t1": {
            "type": "number"
          },
          "text": {
            "type": "string"
          },
          "speaker": {
            "type": "string"
          },
          "id": {
            "type": "integer"
          }
        }
      }
    }
  }
}
